# DRK Vereinsabstimmung - Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an.

# URL der App (fuer Dokumentation / Referenz)
APP_URL=https://drk-abstimmung.de

# URL des PeerJS Signal-Servers (wird als Build-Arg an Next.js uebergeben)
# Muss von den Clients (Browsern) erreichbar sein!
SIGNAL_URL=wss://signal.drk-abstimmung.de

# Signal-Server Port (intern im Container, Standard: 9000)
# PORT=9000
