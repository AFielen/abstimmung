# DRK Vereinsabstimmung - Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an.

# ─── Live-Abstimmung (next-app + peerjs-signal) ──────────────────────────

# URL der App (fuer Dokumentation / Referenz)
APP_URL=https://drk-abstimmung.de

# URL des PeerJS Signal-Servers (wird als Build-Arg an Next.js uebergeben).
# Muss von den Clients (Browsern) erreichbar sein.
# WICHTIG: https:// (NICHT wss://) — der Client leitet daraus selbst wss:// fuer
# die WebSocket-Verbindung ab. wss:// als Wert fuehrt zu CSP-Violations.
SIGNAL_URL=https://signal.drk-abstimmung.de

# Signal-Server Port (intern im Container, Standard: 9000)
# PORT=9000

# ─── Rundlaufbeschlüsse (rundlauf-app + rundlauf-db) ─────────────────────

# Externe URL der Rundlauf-App (wird in Magic-Links eingebaut)
RUNDLAUF_APP_URL=https://rundlauf.drk-abstimmung.de

# Postgres-Passwort fuer den rundlauf-Datenbankuser
RUNDLAUF_DB_PASSWORD=please-replace-me

# Session-Secret fuer iron-session (mindestens 32 Zeichen)
# erzeugen: openssl rand -base64 48
SESSION_SECRET=

# Mailjet API-Credentials (Send API v3.1)
MAILJET_API_KEY=
MAILJET_API_SECRET=

# Absender-Adresse fuer ausgehende Mails (muss in Mailjet verifiziert sein)
MAIL_FROM_EMAIL=noreply@drk-abstimmung.de
MAIL_FROM_NAME=DRK Rundlaufbeschlüsse

# Komma-getrennte Liste an E-Mail-Adressen mit Super-Admin-Rechten
# (KV-Moderation, Notfallzugriff). Diese User werden beim Login automatisch
# als Super-Admin markiert.
SUPERADMIN_EMAILS=admin@drk-aachen.de

# Aufbewahrungsfrist fuer Beschluss-Stimmen in Jahren (Standard: 10)
RETENTION_YEARS=10
